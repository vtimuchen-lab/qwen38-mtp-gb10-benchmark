          "content": "def summarize(rows: list[dict]) -> list[dict]:\n    groups = {}\n    for row in rows:\n        if row.get(\"enabled\") is not True:\n            continue\n        owner = row.get(\"owner\")\n        if not isinstance(owner, str):\n            continue\n        amount = row.get(\"amount\")\n        try:\n            amount_val = float(amount)\n        except (ValueError, TypeError):\n            continue\n        if owner not in groups:\n            groups[owner] = {\"count\": 0, \"total\": 0.0}\n        groups[owner][\"count\"] += 1\n        groups[owner][\"total\"] += amount_val\n    \n    result = []\n    for owner, data in groups.items():\n        result.append({\n            \"owner\": owner,\n            \"count\": data[\"count\"],\n            \"total\": round(data[\"total\"], 2)\n        })\n    \n    result.sort(key=lambda x: (-x[\"total\"], x[\"owner\"]))\n    return result",
